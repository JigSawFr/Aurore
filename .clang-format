---
# clang-format 18; CI checks the files a pull request changes
BasedOnStyle: WebKit
Standard: c++20
AccessModifierOffset: -2
AlignConsecutiveAssignments: true
BreakBeforeBraces: Allman
IndentCaseLabels: true
PointerAlignment: Left
# Sorted within each block; a blank line keeps an order that matters (glad before GLFW)
SortIncludes: CaseSensitive
IncludeBlocks: Preserve
IncludeCategories:
  - Regex: '^<aurore(\.hpp|/)'
    Priority: 3
  - Regex: '^<.*\.h>'
    Priority: 1
  - Regex: '^<'
    Priority: 2
  - Regex: '.*'
    Priority: 4
...

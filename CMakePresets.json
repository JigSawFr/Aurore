{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "desktop-glfw",
      "displayName": "Desktop (GLFW)",
      "description": "Windows, macOS or Linux, windowing and input with GLFW, resources built in",
      "inherits": "base",
      "cacheVariables": {
        "AURORE_PLATFORM": "DESKTOP",
        "AURORE_WINDOW": "GLFW",
        "AURORE_LIBROMFS": "ON"
      }
    },
    {
      "name": "desktop-sdl",
      "displayName": "Desktop (SDL2)",
      "description": "Windows, macOS or Linux, windowing and input with SDL2, resources built in",
      "inherits": "base",
      "cacheVariables": {
        "AURORE_PLATFORM": "DESKTOP",
        "AURORE_WINDOW": "SDL2",
        "AURORE_LIBROMFS": "ON"
      }
    },
    {
      "name": "desktop-sdl3",
      "displayName": "Desktop (SDL3)",
      "description": "Windows, macOS or Linux, windowing and input with SDL3, resources built in",
      "inherits": "base",
      "cacheVariables": {
        "AURORE_PLATFORM": "DESKTOP",
        "AURORE_WINDOW": "SDL3",
        "AURORE_LIBROMFS": "ON"
      }
    },
    {
      "name": "desktop-debug",
      "displayName": "Desktop (GLFW, debug)",
      "description": "desktop-glfw with debug information, no optimisation and the inspector on from the start",
      "inherits": "desktop-glfw",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "AURORE_INSPECTOR": "ON"
      }
    },
    {
      "name": "desktop-asan",
      "displayName": "Desktop (GLFW, ASan + UBSan)",
      "description": "desktop-glfw in debug with AddressSanitizer and UndefinedBehaviorSanitizer; GCC or Clang",
      "inherits": "desktop-glfw",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "tests",
      "displayName": "Tests (desktop, GLFW)",
      "description": "The test harness, the demo's tests, the bench and aurore-preview (docs/testing.md)",
      "inherits": "desktop-glfw",
      "cacheVariables": {
        "AURORE_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "switch-deko3d",
      "displayName": "Nintendo Switch (deko3d)",
      "description": "Switch homebrew drawn with deko3d; needs devkitPro and DEVKITPRO set",
      "inherits": "base",
      "cacheVariables": {
        "AURORE_PLATFORM": "SWITCH",
        "AURORE_GRAPHICS": "DEKO3D"
      }
    },
    {
      "name": "switch-gl",
      "displayName": "Nintendo Switch (OpenGL)",
      "description": "Switch homebrew drawn with OpenGL (mesa) and GLFW; needs devkitPro and DEVKITPRO set",
      "inherits": "base",
      "cacheVariables": {
        "AURORE_PLATFORM": "SWITCH",
        "AURORE_GRAPHICS": "GL3",
        "AURORE_WINDOW": "GLFW"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "desktop-glfw",
      "configurePreset": "desktop-glfw"
    },
    {
      "name": "desktop-sdl",
      "configurePreset": "desktop-sdl"
    },
    {
      "name": "desktop-sdl3",
      "configurePreset": "desktop-sdl3"
    },
    {
      "name": "desktop-debug",
      "configurePreset": "desktop-debug"
    },
    {
      "name": "desktop-asan",
      "configurePreset": "desktop-asan"
    },
    {
      "name": "tests",
      "configurePreset": "tests"
    },
    {
      "name": "switch-deko3d",
      "configurePreset": "switch-deko3d",
      "targets": ["aurore_demo.nro"]
    },
    {
      "name": "switch-gl",
      "configurePreset": "switch-gl",
      "targets": ["aurore_demo.nro"]
    }
  ],
  "testPresets": [
    {
      "name": "tests",
      "configurePreset": "tests",
      "output": {
        "outputOnFailure": true
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "tests",
      "displayName": "Configure, build and run the tests",
      "steps": [
        {
          "type": "configure",
          "name": "tests"
        },
        {
          "type": "build",
          "name": "tests"
        },
        {
          "type": "test",
          "name": "tests"
        }
      ]
    }
  ]
}

<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later: the app's files are in neither the cloud backup
     nor a transfer to a new device (allowBackup="false" covers the older
     versions). An app that wants its settings kept includes them here. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>

# Aurore's public headers, read by Doxygen into XML (build_docs/xml), which
# tools/build_api.py turns into the API reference of the website (/api/,
# site/README.md). From the repository's root:
#
#     doxygen docs/Doxyfile
#     python3 tools/build_api.py build_docs/xml build_api
#
# Only the settings that differ from doxygen's defaults are here
# (`doxygen -x docs/Doxyfile` lists them).

PROJECT_NAME           = Aurore
PROJECT_BRIEF          = "A Switch-like interface for your app, on every screen"
OUTPUT_DIRECTORY       = build_docs

# The public headers only: the guides are the website's own pages
INPUT                  = library/include/aurore.hpp \
                         library/include/aurore
FILE_PATTERNS          = *.hpp *.h
RECURSIVE              = YES
# Bundled libraries and the platforms' internals are not Aurore's API
EXCLUDE                = library/include/aurore/extern \
                         library/include/aurore/platforms
STRIP_FROM_PATH        = library/include
STRIP_FROM_INC_PATH    = library/include

# Every class and member, documented or not, without a warning for each one
# left undocumented: most of borealis' API has no comment of its own
EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_NO_PARAMDOC       = NO
WARN_IF_INCOMPLETE_DOC = NO
QUIET                  = YES
# A comment doxygen cannot read fails the build (the CI's docs job)
WARN_AS_ERROR          = FAIL_ON_WARNINGS
# A comment over a group of members (/// @{ … /// @}) documents each of them
DISTRIBUTE_GROUP_DOC   = YES

# The macros that declare members, expanded so the members show
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = __cplusplus
EXPAND_AS_DEFINED      = AURORE_BIND \
                         CONTENT_FROM_XML_RES \
                         CONTENT_FROM_XML_FILE \
                         CONTENT_FROM_XML_STR

# XML only: the pages are the website's (tools/build_api.py)
GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_PROGRAMLISTING     = NO
HAVE_DOT               = NO

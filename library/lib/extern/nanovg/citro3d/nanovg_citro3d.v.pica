;
; The vertex is nanovg's (x, y, u, v). The texture coordinate is an affine
; function of the four, set per draw call: the atlas coordinates for text,
; the paint's inverse transform for images and gradients (the PICA200 has no
; fragment shader: what nanovg's GL shader computes per pixel is computed
; here per vertex, exact since it is affine).

; uniforms
.fvec proj[4]      ; screen projection (rotated: the screens are portrait)
.fvec texRow[2]    ; s = texRow[0] . (x, y, u, v) + texOff.x, t likewise
.fvec texOff
.fvec aaRow        ; x: the edges' coverage texture's row (nanovg_citro3d_aa.h)

; constants
.constf ones(1.0, 0.0, 0.0, 0.0)

; outputs
.out outPos   position
.out outTc    texcoord0
.out outColor color
.out outTc1   texcoord1

; inputs
.alias inVert v0

.proc main
	; position (x, y, 0, 1)
	mov r0.xy, inVert.xy
	mov r0.zw, ones.yx

	dp4 outPos.x, proj[0], r0
	dp4 outPos.y, proj[1], r0
	dp4 outPos.z, proj[2], r0
	dp4 outPos.w, proj[3], r0

	; texture coordinate
	dp4 r1.x, texRow[0], inVert
	dp4 r1.y, texRow[1], inVert
	add r1.xy, texOff.xy, r1.xy
	mov r1.zw, ones.yy
	mov outTc, r1

	; the edges' coverage: u across the edge, the call's row
	mov r2.x, inVert.z
	mov r2.y, aaRow.x
	mov r2.zw, ones.yy
	mov outTc1, r2

	; the colours come from the combiners' constants
	mov outColor, ones.xxxx

	end
.end

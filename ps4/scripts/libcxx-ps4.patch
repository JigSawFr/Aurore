 inline _LIBCPP_HIDE_FROM_ABI float __strtof(const char* __nptr, char** __endptr, __locale_t __loc) {
+#  ifdef __PS4__ // OpenOrbis' musl has no strtof_l, and the PS4 only the C locale
+  (void)__loc;
+  return ::strtof(__nptr, __endptr);
+#  else
   return ::strtof_l(__nptr, __endptr, __loc);
+#  endif
 }
 
 inline _LIBCPP_HIDE_FROM_ABI double __strtod(const char* __nptr, char** __endptr, __locale_t __loc) {
+#  ifdef __PS4__ // OpenOrbis' musl has no strtod_l, and the PS4 only the C locale
+  (void)__loc;
+  return ::strtod(__nptr, __endptr);
+#  else
   return ::strtod_l(__nptr, __endptr, __loc);
+#  endif
 }
 
 inline _LIBCPP_HIDE_FROM_ABI long double __strtold(const char* __nptr, char** __endptr, __locale_t __loc) {
+#  ifdef __PS4__ // OpenOrbis' musl has no strtold_l, and the PS4 only the C locale
+  (void)__loc;
+  return ::strtold(__nptr, __endptr);
+#  else
   return ::strtold_l(__nptr, __endptr, __loc);
+#  endif
 }
 

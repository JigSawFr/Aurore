--- a/cmake/ps4.cmake
+++ b/cmake/ps4.cmake
@@ -69,7 +69,8 @@
    -I${OPENORBIS}/usr/include")
 
 set(CMAKE_C_FLAGS_INIT "${CMAKE_ASM_FLAGS_INIT}")
-set(CMAKE_CXX_FLAGS_INIT "${CMAKE_C_FLAGS_INIT} -I${OPENORBIS}/include/c++/v1")
+# libc++ before the C headers: its <math.h>, <stdio.h>… wrap musl's
+set(CMAKE_CXX_FLAGS_INIT "-isystem ${OPENORBIS}/include/c++/v1 ${CMAKE_C_FLAGS_INIT}")
 
 set(CMAKE_C_STANDARD_LIBRARIES "-lkernel -lc -lclang_rt.builtins-x86_64 -lSceLibcInternal")
 set(CMAKE_CXX_STANDARD_LIBRARIES "${CMAKE_C_STANDARD_LIBRARIES} -lc++")
--- a/include/math.h
+++ b/include/math.h
@@ -65,7 +65,7 @@
 	return __u.__i;
 }
 
-#ifdef __cplusplus
+#if 0 // C++ overloads for libc++ 12; libc++ 23 wraps musl's macros itself
 
 #define _fpclassify(x) ( \
 	sizeof(x) == sizeof(float) ? __fpclassifyf(x) : \
--- a/ps4vars.sh
+++ b/ps4vars.sh
@@ -25,8 +25,9 @@
 export ARCH="--target=x86_64-pc-freebsd12-elf"
 export CFLAGS="${ARCH} -D__PS4__ -D__OPENORBIS__ -D__ORBIS__ -DPS4 -D__BSD_VISIBLE -D_BSD_SOURCE -O2 -fPIC -funwind-tables"
 export CFLAGS="${CFLAGS} -isysroot ${OPENORBIS} -isystem ${OPENORBIS}/include -I${OPENORBIS}/usr/include"
-export CXXFLAGS="${CFLAGS} -isystem ${OPENORBIS}/include/c++/v1"
-export CPPFLAGS="${CFLAGS} -isystem ${OPENORBIS}/include/c++/v1"
+# libc++ before the C headers: its <math.h>, <stdio.h>… wrap musl's
+export CXXFLAGS="-isystem ${OPENORBIS}/include/c++/v1 ${CFLAGS}"
+export CPPFLAGS="-isystem ${OPENORBIS}/include/c++/v1 ${CFLAGS}"
 
 export LIBS="-L${OPENORBIS}/lib -L${OPENORBIS}/usr/lib -lc -lclang_rt.builtins-x86_64 -lkernel -lSceLibcInternal"
 export LDFLAGS="${ARCH} -fuse-ld=lld -Wl,-melf_x86_64 -Wl,-pie -Wl,--script=${OPENORBIS}/link.x -Wl,--eh-frame-hdr ${LIBS} -nostdlib"

<aurore:Box
    width="auto"
    height="auto">

    <aurore:ScrollingFrame
        width="auto"
        height="auto"
        grow="1.0" >

        <aurore:Box
            width="auto"
            height="auto"
            axis="column"
            paddingLeft="@style/aurore/tab_frame/content_padding_sides"
            paddingRight="@style/aurore/tab_frame/content_padding_sides"
            paddingTop="@style/aurore/tab_frame/content_padding_top_bottom"
            paddingBottom="@style/aurore/tab_frame/content_padding_top_bottom">

                <aurore:Label
                    width="auto"
                    height="auto"
                    text="@i18n/demo/welcome"
                    marginBottom="10px" />

                <!-- HScroll -->
                <aurore:Header
                    width="auto"
                    height="auto"
                    title="@i18n/demo/components_more/hscroll"
                    marginBottom="30px" />

                <aurore:HScrollingFrame
                    width="auto"
                    height="240"
                    grow="1.0">

                    <aurore:Box
                        width="auto"
                        height="auto"
                        axis="row">
                        <CaptionedImage
                            width="auto"
                            height="auto"
                            imageWidth="auto"
                            imageHeight="auto"
                            image="@res/img/tiles.png"
                            caption="@i18n/demo/components/images_original"
                            paddingRight="6" />
                        <CaptionedImage
                            width="auto"
                            height="auto"
                            imageWidth="auto"
                            imageHeight="auto"
                            image="@res/img/tiles.png"
                            caption="@i18n/demo/components/images_original"
                            paddingRight="6" />
                        <CaptionedImage
                            width="auto"
                            height="auto"
                            imageWidth="auto"
                            imageHeight="auto"
                            image="@res/img/tiles.png"
                            caption="@i18n/demo/components/images_original"
                            paddingRight="6" />
                        <CaptionedImage
                            width="auto"
                            height="auto"
                            imageWidth="auto"
                            imageHeight="auto"
                            image="@res/img/tiles.png"
                            caption="@i18n/demo/components/images_original"
                            paddingRight="6" />
                        <CaptionedImage
                            width="auto"
                            height="auto"
                            imageWidth="auto"
                            imageHeight="auto"
                            image="@res/img/tiles.png"
                            caption="@i18n/demo/components/images_original"
                            paddingRight="6" />
                        <CaptionedImage
                            width="auto"
                            height="auto"
                            imageWidth="auto"
                            imageHeight="auto"
                            image="@res/img/tiles.png"
                            caption="@i18n/demo/components/images_original"
                            paddingRight="6" />
                        <CaptionedImage
                            width="auto"
                            height="auto"
                            imageWidth="auto"
                            imageHeight="auto"
                            image="@res/img/tiles.png"
                            caption="@i18n/demo/components/images_original"
                            paddingRight="6" />
                        <CaptionedImage
                            width="auto"
                            height="auto"
                            imageWidth="auto"
                            imageHeight="auto"
                            image="@res/img/tiles.png"
                            caption="@i18n/demo/components/images_original"
                            paddingRight="6" />
                        <CaptionedImage
                            width="auto"
                            height="auto"
                            imageWidth="auto"
                            imageHeight="auto"
                            image="@res/img/tiles.png"
                            caption="@i18n/demo/components/images_original"
                            paddingRight="6" />

                    </aurore:Box>

                </aurore:HScrollingFrame>

                <!-- Buttons -->
                <aurore:Header
                    width="auto"
                    height="auto"
                    title="@i18n/demo/components/buttons_header"
                    marginBottom="30px" />

                <aurore:Box
                    width="100%"
                    height="auto"
                    axis="row"
                    marginBottom="30px">

                    <aurore:Button
                        id="button_primary"
                        width="auto"
                        height="auto"
                        style="primary"
                        grow="1.0"
                        marginRight="30px"
                        text="@i18n/demo/components/button_primary" />

                    <aurore:Button
                        id="button_highlight"
                        width="auto"
                        height="auto"
                        style="highlight"
                        text="@i18n/demo/components/button_highlight"
                        focusDown="button_bordered" />

                </aurore:Box>

                <aurore:Box
                    width="100%"
                    height="auto"
                    axis="row"
                    marginBottom="30px">

                    <aurore:Button
                        width="33%"
                        height="auto"
                        marginRight="30px"
                        text="@i18n/demo/components/button_wrapping" />

                    <aurore:Box
                        width="auto"
                        height="auto"
                        grow="1.0"
                        axis="column">

                        <aurore:Button
                            id="button_bordered"
                            width="auto"
                            height="auto"
                            padding="10px"
                            style="bordered"
                            fontSize="16"
                            text="@i18n/demo/components/button_bordered"
                            marginBottom="30px" />

                        <aurore:Button
                            width="auto"
                            height="auto"
                            padding="10px"
                            style="borderless"
                            fontSize="16"
                            text="@i18n/demo/components/button_borderless" />

                    </aurore:Box>

                </aurore:Box>
                
                <!-- Icon buttons and context menu -->
                <aurore:Header
                    width="auto"
                    height="auto"
                    title="@i18n/demo/components/icon_buttons_header"
                    subtitle="@i18n/demo/components/icon_buttons_subtitle"
                    marginBottom="30px" />

                <aurore:Box
                    width="100%"
                    height="auto"
                    axis="row"
                    alignItems="center"
                    marginBottom="30px">

                    <aurore:IconButton
                        id="icon_menu"
                        glyph="&#xE5D4;"
                        accessibilityLabel="@i18n/demo/components/icon_menu"
                        marginRight="30px" />

                    <aurore:IconButton
                        id="icon_play"
                        style="primary"
                        glyph="&#xE037;"
                        text="@i18n/demo/components/icon_play"
                        marginRight="30px" />

                    <aurore:IconButton
                        style="bordered"
                        icon="@res/img/aurore_96.png"
                        iconSize="28"
                        text="@i18n/demo/components/icon_image"
                        marginRight="30px" />

                    <aurore:IconButton
                        style="borderless"
                        glyph="&#xE8B8;"
                        accessibilityLabel="@i18n/demo/components/icon_settings" />

                </aurore:Box>

                <!-- Scroll -->
                <aurore:Header
                    width="auto"
                    height="auto"
                    title="@i18n/demo/components/slider_header"
                    marginBottom="15px" />
                
                <aurore:Box
                    width="auto"
                    height="auto"
                    axis="row">
                    
                    <aurore:Label
                        id="progress"
                        width="80"
                        height="40"
                        text="100"
                        marginBottom="10px"
                        horizontalAlign="center"
                        verticalAlign="center" />
                        
                    <aurore:Slider
                        id="slider"
                        width="auto"
                        height="40"
                        grow="1"/>
                    
                </aurore:Box>

                <!-- Labels -->
                <aurore:Header
                    width="auto"
                    height="auto"
                    title="@i18n/demo/components/labels_header"
                    marginBottom="30px" />

                <aurore:Label
                    width="auto"
                    height="auto"
                    text="@i18n/demo/components/regular_label"
                    marginBottom="30px" />

                <aurore:Box
                    width="auto"
                    height="auto"
                    axis="row"
                    justifyContent="spaceEvenly"
                    marginBottom="30px" >

                    <aurore:Label
                        width="30%"
                        height="auto"
                        text="@i18n/demo/components/label_left"
                        horizontalAlign="left" />

                    <aurore:Label
                        width="30%"
                        height="auto"
                        text="@i18n/demo/components/label_center"
                        horizontalAlign="center" />

                    <aurore:Label
                        width="30%"
                        height="auto"
                        text="@i18n/demo/components/label_right"
                        horizontalAlign="right" />

                </aurore:Box>

                <!-- Images -->
                <aurore:Header
                    width="auto"
                    height="auto"
                    title="@i18n/demo/components/images_header_title"
                    subtitle="@i18n/demo/components/images_header_subtitle"
                    marginBottom="30px" />

                <aurore:Box
                    width="auto"
                    height="auto"
                    axis="row"
                    alignItems="center"
                    justifyContent="spaceEvenly"
                    marginBottom="30px">

                    <CaptionedImage
                        width="auto"
                        height="auto"
                        imageWidth="76px"
                        imageHeight="76px"
                        image="@res/img/tiles.png"
                        caption="@i18n/demo/components/images_downscaled" />

                    <CaptionedImage
                        id="image_original"
                        width="auto"
                        height="auto"
                        imageWidth="auto"
                        imageHeight="auto"
                        image="@res/img/tiles.png"
                        caption="@i18n/demo/components/images_original" />

                    <CaptionedImage
                        id="image_upscaled"
                        width="auto"
                        height="auto"
                        imageWidth="170px"
                        imageHeight="170px"
                        maxWidth="170px"
                        image="@res/img/tiles.png"
                        caption="@i18n/demo/components/images_upscaled"
                        focusDown="image_cropped" />

                </aurore:Box>

                <aurore:Box
                    width="auto"
                    height="auto"
                    axis="row"
                    alignItems="center"
                    justifyContent="spaceEvenly">

                    <CaptionedImage
                        width="auto"
                        height="auto"
                        imageWidth="400px"
                        imageHeight="75px"
                        image="@res/img/tiles.png"
                        scalingType="stretch"
                        caption="@i18n/demo/components/images_stretched" />

                    <CaptionedImage
                        id="image_cropped"
                        width="auto"
                        height="auto"
                        imageWidth="auto"
                        imageHeight="75px"
                        image="@res/img/tiles.png"
                        scalingType="center"
                        caption="@i18n/demo/components/images_cropped"
                        focusUp="image_upscaled" />

                </aurore:Box>

        </aurore:Box>

    </aurore:ScrollingFrame>

</aurore:Box>

<aurore:Box
    width="auto"
    height="auto"
    axis="column"
    paddingLeft="@style/aurore/tab_frame/content_padding_sides"
    paddingRight="@style/aurore/tab_frame/content_padding_sides"
    paddingTop="@style/aurore/tab_frame/content_padding_top_bottom">

    <aurore:Header
        width="auto"
        height="auto"
        title="@i18n/demo/grid/row_title"
        subtitle="@i18n/demo/grid/row_subtitle"
        marginBottom="10px" />

    <!-- One row of 40 items, 120 px wide -->
    <aurore:HRecyclerFrame
        id="row"
        width="auto"
        height="150"
        itemWidth="120"
        itemSpace="16"
        paddingTop="6"
        paddingBottom="6"
        paddingLeft="6"
        paddingRight="6" />

    <aurore:Header
        id="grid_header"
        width="auto"
        height="auto"
        title="@i18n/demo/grid/grid_title"
        marginTop="10px"
        marginBottom="10px" />

    <!-- As many 170 px columns as fit; more items load at the end -->
    <aurore:RecyclingGrid
        id="grid"
        width="auto"
        height="auto"
        grow="1.0"
        columnWidth="170"
        itemHeight="200"
        itemSpace="16"
        paddingTop="6"
        paddingBottom="30"
        paddingLeft="6"
        paddingRight="6" />

</aurore:Box>

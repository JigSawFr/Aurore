<aurore:ScrollingFrame
        width="auto"
        height="auto"
        axis="column"
        grow="1.0">

    <aurore:Box
            alignItems="center"
            width="auto"
            axis="column"
            marginRight="30"
            height="auto">

        <aurore:Box
                backgroundColor="@theme/aurore/backdrop"
                justifyContent="center"
                margin="10"
                width="90%"
                cornerRadius="4"
                height="70">
            <aurore:Rectangle
                    width="50"
                    height="50"
                    margin="10"
                    cornerRadius="4"
                    color="#50FFDD"/>
            <aurore:Rectangle
                    width="50"
                    height="50"
                    margin="10"
                    cornerRadius="4"
                    color="#50FFDD"/>
            <aurore:Rectangle
                    width="50"
                    height="50"
                    margin="10"
                    cornerRadius="4"
                    color="#50FFDD"/>
        </aurore:Box>
        <aurore:Label
                width="auto"
                height="auto"
                text="alignItems: center"
                marginBottom="10px" />

        <aurore:Box
                backgroundColor="@theme/aurore/backdrop"
                justifyContent="spaceBetween"
                margin="10"
                width="90%"
                cornerRadius="4"
                height="70">
            <aurore:Rectangle
                    width="50"
                    height="50"
                    margin="10"
                    cornerRadius="4"
                    color="#50FFDD"/>
            <aurore:Rectangle
                    width="50"
                    height="50"
                    margin="10"
                    cornerRadius="4"
                    color="#50FFDD"/>
            <aurore:Rectangle
                    width="50"
                    height="50"
                    margin="10"
                    cornerRadius="4"
                    color="#50FFDD"/>
        </aurore:Box>
        <aurore:Label
                width="auto"
                height="auto"
                text="alignItems: spaceBetween"
                marginBottom="10px" />
        <aurore:Box
                backgroundColor="@theme/aurore/backdrop"
                justifyContent="flexStart"
                margin="10"
                width="90%"
                cornerRadius="4"
                height="70">
            <aurore:Rectangle
                    width="50"
                    height="50"
                    margin="10"
                    cornerRadius="4"
                    color="#FF0000"/>
            <aurore:Rectangle
                    width="50"
                    height="50"
                    margin="10"
                    cornerRadius="4"
                    color="#00FF00"/>
            <aurore:Rectangle
                    width="50"
                    height="50"
                    margin="10"
                    cornerRadius="4"
                    color="#0000FF"/>
        </aurore:Box>
        <aurore:Label
                width="auto"
                height="auto"
                text="alignItems: flexStart"
                marginBottom="10px" />

        <aurore:Box
                backgroundColor="@theme/aurore/backdrop"
                justifyContent="flexEnd"
                margin="10"
                width="90%"
                cornerRadius="4"
                height="70">
            <aurore:Rectangle
                    width="50"
                    height="50"
                    margin="10"
                    cornerRadius="4"
                    color="#FF0000"/>
            <aurore:Rectangle
                    width="50"
                    height="50"
                    margin="10"
                    cornerRadius="4"
                    color="#00FF00"/>
            <aurore:Rectangle
                    width="50"
                    height="50"
                    margin="10"
                    cornerRadius="4"
                    color="#0000FF"/>
        </aurore:Box>
        <aurore:Label
                width="auto"
                height="auto"
                text="alignItems: flexEnd"
                marginBottom="10px" />

        <aurore:Box
                backgroundColor="@theme/aurore/backdrop"
                justifyContent="flexEnd"
                direction="rightToLeft"
                margin="10"
                width="90%"
                cornerRadius="4"
                height="70">
            <aurore:Rectangle
                    width="50"
                    height="50"
                    margin="10"
                    cornerRadius="4"
                    color="#FF0000"/>
            <aurore:Rectangle
                    width="50"
                    height="50"
                    margin="10"
                    cornerRadius="4"
                    color="#00FF00"/>
            <aurore:Rectangle
                    width="50"
                    height="50"
                    margin="10"
                    cornerRadius="4"
                    color="#0000FF"/>
        </aurore:Box>
        <aurore:Label
                width="auto"
                height="auto"
                text="alignItems: flexEnd; direction: rightToLeft"
                marginBottom="10px" />

        <aurore:Box
                backgroundColor="@theme/aurore/backdrop"
                justifyContent="center"
                margin="10"
                width="90%"
                cornerRadius="4"
                height="70">
            <aurore:Rectangle
                    width="50"
                    height="50"
                    margin="10"
                    grow="1"
                    cornerRadius="4"
                    color="#50FFDD"/>
            <aurore:Rectangle
                    width="50"
                    height="50"
                    margin="10"
                    grow="2"
                    cornerRadius="4"
                    color="#50FFDD"/>
            <aurore:Rectangle
                    width="50"
                    height="50"
                    margin="10"
                    grow="1"
                    cornerRadius="4"
                    color="#50FFDD"/>
        </aurore:Box>
        <aurore:Label
                width="auto"
                height="auto"
                text="grow: 1 / 2 / 1"
                marginBottom="10px" />

        <aurore:Box
                backgroundColor="@theme/aurore/backdrop"
                wireframe="true"
                axis="column"
                margin="10"
                width="90%"
                cornerRadius="4"
                height="210">
            <aurore:Rectangle
                    width="50"
                    height="50"
                    margin="10"
                    grow="1"
                    cornerRadius="4"
                    color="#50FFDD"/>
            <aurore:Rectangle
                    width="50"
                    height="50"
                    margin="10"
                    grow="2"
                    cornerRadius="4"
                    color="#50FFDD"/>
            <aurore:Rectangle
                    width="50"
                    height="50"
                    margin="10"
                    grow="1"
                    cornerRadius="4"
                    color="#50FFDD"/>
        </aurore:Box>
        <aurore:Label
                width="auto"
                height="auto"
                text="axis: column; wireframe: true"
                marginBottom="10px" />

    </aurore:Box>

</aurore:ScrollingFrame>
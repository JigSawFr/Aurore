<!-- Emoji and other scripts. Colour emoji need USE_FREETYPE and a colour
     emoji font (FontLoader::USER_EMOJI_PATH, or the system's on desktop);
     Arabic and Hebrew in reading order need USE_FRIBIDI. -->
<brls:Box
    width="auto"
    height="auto">

    <brls:ScrollingFrame
        width="auto"
        height="auto"
        grow="1.0" >

        <brls:Box
            width="auto"
            height="auto"
            axis="column"
            paddingLeft="@style/brls/tab_frame/content_padding_sides"
            paddingRight="@style/brls/tab_frame/content_padding_sides"
            paddingTop="@style/brls/tab_frame/content_padding_top_bottom"
            paddingBottom="@style/brls/tab_frame/content_padding_top_bottom">

            <brls:Header
                width="auto"
                height="auto"
                title="Emoji"
                marginBottom="20px" />
            <brls:Box
                width="auto"
                height="auto"
                axis="column"
                focusable="true"
                paddingTop="10"
                paddingBottom="10"
                paddingLeft="10"
                paddingRight="10"
                marginBottom="30px">
                <brls:Label
                    width="auto"
                    height="auto"
                    fontSize="36"
                    text="🚀 🎮 ✅ ⭐ 😀 🎉 🌍 ❤️ 👍"
                    marginBottom="20px" />
                <brls:Label
                    width="auto"
                    height="auto"
                    text="Inline with text: build passed ✅, release 🚀 shipped, 3 games 🎮 added."
                    marginBottom="20px" />
                <brls:Label
                    width="auto"
                    height="auto"
                    fontSize="16"
                    textColor="#808080"
                    text="Small and faded: 🍕 🐱 🌈 🔒 📦" />
            </brls:Box>

            <brls:Header
                width="auto"
                height="auto"
                title="Scripts"
                marginBottom="20px" />
            <brls:Box
                width="auto"
                height="auto"
                axis="column"
                focusable="true"
                paddingTop="10"
                paddingBottom="10"
                paddingLeft="10"
                paddingRight="10"
                marginBottom="30px">
                <brls:Label
                    width="auto"
                    height="auto"
                    text="Latin: Ça déménage à Zürich, ñandú, łódź"
                    marginBottom="12px" />
                <brls:Label
                    width="auto"
                    height="auto"
                    text="Greek and Cyrillic: Καλημέρα κόσμε · Привет, мир"
                    marginBottom="12px" />
                <brls:Label
                    width="auto"
                    height="auto"
                    text="CJK: 日本語のテキスト · 简体中文 · 한국어"
                    marginBottom="12px" />
                <brls:Label
                    width="auto"
                    height="auto"
                    text="Arabic: مرحبا بالعالم"
                    marginBottom="12px" />
                <brls:Label
                    width="auto"
                    height="auto"
                    text="Hebrew: שלום עולם (1)" />
            </brls:Box>

        </brls:Box>

    </brls:ScrollingFrame>

</brls:Box>

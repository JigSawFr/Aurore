<aurore:Box
    width="auto"
    height="auto">

    <aurore:ScrollingFrame
        width="auto"
        height="auto"
        axis="column"
        alignItems="stretch"
        scrollingBehavior="centered"
        grow="1.0" >
        
        <aurore:Box
            width="10000"
            height="auto"
            axis="column"
            alignItems="stretch"
            paddingTop="@style/aurore/tab_frame/content_padding_top_bottom"
            paddingRight="@style/aurore/tab_frame/content_padding_sides"
            paddingBottom="@style/aurore/tab_frame/content_padding_top_bottom"
            paddingLeft="@style/aurore/tab_frame/content_padding_sides">
                
            <aurore:BooleanCell
                id="boolean"/>
                
            <aurore:SelectorCell
                id="selector"/>
                
            <aurore:InputCell
                id="input"/>
                
            <aurore:InputNumericCell
                id="inputNumeric"/>

            <aurore:DetailCell
                title="@i18n/demo/settings/ip"
                id="ipAddress"/>
            
            <aurore:DetailCell
                title="@i18n/demo/settings/dns"
                id="dnsServer"/>

            <aurore:BooleanCell
                id="debug"/>

            <aurore:BooleanCell
                id="screenSaver"/>

            <aurore:BooleanCell
                id="bottomBar"/>

            <aurore:BooleanCell
                id="alwaysOnTop"/>

            <aurore:BooleanCell
                id="fps"/>

            <aurore:SelectorCell
                id="swapInterval"/>

            <aurore:SliderCell
                    id="slider"/>

            <aurore:DetailCell
                    title="@i18n/demo/settings/notify"
                    id="notify"/>

        </aurore:Box>

    </aurore:ScrollingFrame>

</aurore:Box>

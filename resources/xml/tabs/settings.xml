<brls:Box
    width="auto"
    height="auto">

    <brls:ScrollingFrame
        width="auto"
        height="auto"
        axis="column"
        alignItems="stretch"
        scrollingBehavior="centered"
        grow="1.0" >
        
        <brls:Box
            width="10000"
            height="auto"
            axis="column"
            alignItems="stretch"
            paddingTop="@style/brls/tab_frame/content_padding_top_bottom"
            paddingRight="@style/brls/tab_frame/content_padding_sides"
            paddingBottom="@style/brls/tab_frame/content_padding_top_bottom"
            paddingLeft="@style/brls/tab_frame/content_padding_sides">
            
            <brls:RadioCell
                id="radio"/>
                
            <brls:BooleanCell
                id="boolean"/>
                
            <brls:SelectorCell
                id="selector"/>
                
            <brls:InputCell
                id="input"/>
                
            <brls:InputNumericCell
                id="inputNumeric"/>

            <brls:DetailCell
                title="@i18n/demo/settings/ip"
                id="ipAddress"/>
            
            <brls:DetailCell
                title="@i18n/demo/settings/dns"
                id="dnsServer"/>

            <brls:BooleanCell
                id="debug"/>

            <brls:BooleanCell
                id="screenSaver"/>

            <brls:BooleanCell
                id="bottomBar"/>

            <brls:BooleanCell
                id="alwaysOnTop"/>

            <brls:BooleanCell
                id="fps"/>

            <brls:SelectorCell
                id="swapInterval"/>

            <brls:SliderCell
                    id="slider"/>

            <brls:DetailCell
                    title="@i18n/demo/settings/notify"
                    id="notify"/>

            <brls:Header
                width="auto"
                height="auto"
                title="@i18n/demo/settings/themes"
                subtitle="@i18n/demo/settings/themes_subtitle"
                marginTop="40"/>

            <brls:BooleanCell
                id="themeDark"/>

            <brls:Box
                id="themes"
                width="auto"
                height="auto"
                axis="column"
                alignItems="stretch"/>

        </brls:Box>

    </brls:ScrollingFrame>

</brls:Box>

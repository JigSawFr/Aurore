<aurore:Box
        width="auto"
        height="auto">

<aurore:ScrollingFrame
        width="auto"
        height="auto"
        grow="1.0">

    <aurore:Box
            width="auto"
            height="auto"
            axis="column"
            paddingLeft="@style/aurore/tab_frame/content_padding_sides"
            paddingRight="@style/aurore/tab_frame/content_padding_sides"
            paddingTop="@style/aurore/tab_frame/content_padding_top_bottom"
            paddingBottom="@style/aurore/tab_frame/content_padding_top_bottom">

        <aurore:Label
                text="@i18n/demo/styles/states"
                fontSize="24"
                accessibilityRole="header"
                marginBottom="10" />

        <aurore:Box axis="row" height="auto">

            <!-- focus: and pressed:, with a transition on each -->
            <aurore:Box
                    id="styles/fade"
                    focusable="true"
                    hideHighlightBackground="true"
                    width="230"
                    height="110"
                    margin="10"
                    cornerRadius="12"
                    justifyContent="center"
                    alignItems="center"
                    backgroundColor="@theme/aurore/button/default_enabled_background"
                    focus:backgroundColor="@theme/aurore/button/primary_enabled_background"
                    pressed:scale="0.94"
                    transition="backgroundColor 180ms ease-out, scale 120ms ease-out"
                    accessibilityRole="button"
                    accessibilityLabel="@i18n/demo/styles/fade">
                <aurore:Label text="@i18n/demo/styles/fade" />
            </aurore:Box>

            <!-- several properties at once, with an overshoot -->
            <aurore:Box
                    focusable="true"
                    hideHighlight="true"
                    width="230"
                    height="110"
                    margin="10"
                    cornerRadius="4"
                    borderThickness="3"
                    justifyContent="center"
                    alignItems="center"
                    backgroundColor="@theme/aurore/button/default_enabled_background"
                    borderColor="#00000000"
                    focus:borderColor="@theme/aurore/accent"
                    focus:cornerRadius="28"
                    transition="all 300ms backOut"
                    accessibilityRole="button"
                    accessibilityLabel="@i18n/demo/styles/corners">
                <aurore:Label text="@i18n/demo/styles/corners" />
            </aurore:Box>

            <!-- hover: follows the mouse pointer (desktop) -->
            <aurore:Box
                    focusable="true"
                    width="230"
                    height="110"
                    margin="10"
                    cornerRadius="12"
                    justifyContent="center"
                    alignItems="center"
                    backgroundColor="@theme/aurore/button/default_enabled_background"
                    hover:backgroundColor="@theme/aurore/accent/hover"
                    transition="backgroundColor 150ms"
                    accessibilityRole="button"
                    accessibilityLabel="@i18n/demo/styles/hover">
                <aurore:Label text="@i18n/demo/styles/hover" />
            </aurore:Box>
        </aurore:Box>

        <aurore:Box axis="row" height="auto" alignItems="center">
            <aurore:Button
                    id="styles/disabled"
                    text="@i18n/demo/styles/disabled"
                    width="300"
                    margin="10"
                    style="primary"
                    disabled:alpha="0.4"
                    transition="alpha 200ms" />
            <aurore:Button
                    id="styles/toggle"
                    text="@i18n/demo/styles/toggle"
                    width="300"
                    margin="10" />
        </aurore:Box>

        <aurore:Label
                text="@i18n/demo/styles/binding"
                fontSize="24"
                accessibilityRole="header"
                marginTop="20"
                marginBottom="10" />

        <aurore:Box axis="row" height="auto" alignItems="center">
            <aurore:Button
                    id="styles/increment"
                    text="@i18n/demo/styles/add_one"
                    width="200"
                    margin="10" />
            <!-- text: and color: follow the model's observables -->
            <aurore:Label
                    bind="text: styles.counter"
                    fontSize="40"
                    width="100"
                    horizontalAlign="center"
                    margin="10" />
            <aurore:Rectangle
                    bind="color: styles.swatch"
                    transition="color 300ms ease-in-out"
                    width="60"
                    height="60"
                    cornerRadius="30"
                    margin="10" />
            <aurore:Label
                    text="@i18n/demo/styles/even"
                    bind="visible: styles.even"
                    margin="10" />
        </aurore:Box>

        <aurore:BooleanCell id="styles/reduce_motion" />

        <aurore:Label
                bind="text: styles.announced"
                marginTop="10"
                fontSize="18"
                textColor="@theme/aurore/header/subtitle" />

    </aurore:Box>

</aurore:ScrollingFrame>

</aurore:Box>

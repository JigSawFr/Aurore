<aurore:AppletFrame>
    <aurore:TabFrame title="@i18n/app/title">

        <aurore:Tab label="@i18n/app/tabs/home">
            <HomeTab />
        </aurore:Tab>

        <aurore:Tab label="@i18n/app/tabs/about">
            <aurore:Box
                axis="column"
                alignItems="center"
                justifyContent="center"
                grow="1">

                <aurore:Label
                    text="@i18n/app/about/text"
                    horizontalAlign="center" />

            </aurore:Box>
        </aurore:Tab>

    </aurore:TabFrame>
</aurore:AppletFrame>
